# Copy to .env (local) or .env.production (VPS). Never commit real values.
# Keys marked (required) are checked at boot by src/config/env.validation.ts.

# ---- App ----
PORT=8081
# development | production
NODE_ENV=development
# used in email links; (required in production)
FE_URL=http://localhost:3000
# comma-separated allowlist; (required in production)
CORS_ORIGINS=http://localhost:3000
# set to 1 when running behind nginx/Caddy
TRUST_PROXY=
# Swagger is always on outside production
SWAGGER_ENABLED=false

# ---- Logging ----
# fatal | error | warn | info | debug | trace (default: info in production, debug otherwise)
LOG_LEVEL=

# ---- Sentry (optional: leave SENTRY_DSN empty to disable) ----
SENTRY_DSN=
# 0..1 share of requests traced; 0 keeps the free quota for errors only
SENTRY_TRACES_SAMPLE_RATE=0

# ---- MongoDB ----
# Local: the URL for docker-compose.yml. Production compose builds MONGO_URL from the MONGO_INITDB_* values.
# (required)
MONGO_URL=mongodb://root:123456@localhost:27017/my-job-portal?authSource=admin
MONGO_INITDB_ROOT_USERNAME=root
# production: URL-safe random value, e.g. `openssl rand -hex 24`
MONGO_INITDB_ROOT_PASSWORD=123456
MONGO_INITDB_DATABASE=my-job-portal

# ---- Redis ----
REDIS_HOST=localhost
REDIS_PORT=6379
# required by docker-compose.prod.yml
REDIS_PASSWORD=
REDIS_QUEUE_DB=0
REDIS_CACHE_DB=1
REDIS_TTL=3600000

# ---- Auth (generate secrets with `openssl rand -hex 32`) ----
# (required)
JWT_ACCESS_TOKEN_SECRET=
# (required)
JWT_ACCESS_EXPIRES_IN=15m
# (required)
JWT_REFRESH_TOKEN_SECRET=
# (required)
JWT_REFRESH_EXPIRES_IN=7d
# (required)
OTP_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Seed admin ----
EMAIL_ADMIN=
INIT_PASSWORD=

# ---- Mail (SMTP) ----
SMTP_HOST=
SMTP_EMAIL=
SMTP_PASSWORD=

# ---- AI providers ----
# (required) GeminiService refuses to start without it
GEMINI_API_KEY=
GEMINI_MODEL=
GROQ_API_KEY=
GROQ_CHAT_MODEL=
GROQ_SUMMARY_MODEL=

# ---- Groq chat budgets (required, checked by AIService; values below are the recommended defaults) ----
AI_GROQ_HISTORY_LIMIT=6
AI_GROQ_MAX_INPUT_TOKENS=6000
AI_GROQ_MAX_MATCHING_JOBS=3
AI_GROQ_MAX_SEARCH_RESULTS=3
AI_GROQ_MAX_COMPANY_ITEMS=2
AI_GROQ_MAX_TOP_SKILLS=5
AI_GROQ_MAX_TOP_COMPANIES=5
AI_GROQ_MAX_SUMMARY_CHARS=400

# ---- Optional AI / chat tuning (code has defaults; see src/ai, src/gemini, src/groq, src/chat) ----
# AI_CHAT_PRIMARY_PROVIDER=
# AI_CHAT_GEMINI_FALLBACK_ENABLED=
# AI_SUMMARY_PRIMARY_PROVIDER=
# AI_SUMMARY_GEMINI_FALLBACK_ENABLED=
# AI_COST_GROQ_PROMPT_USD_PER_1K=
# AI_COST_GROQ_COMPLETION_USD_PER_1K=
# GROQ_TIMEOUT_MS=
# GROQ_MAX_RETRIES=
# GEMINI_RPM=
# GEMINI_DAILY_BUDGET=
# GEMINI_DAILY_ALERT_THRESHOLDS=
# GEMINI_PARSE_MINUTE_RESERVE=
# GEMINI_PARSE_DAILY_RESERVE=
# GEMINI_SUMMARY_MINUTE_RESERVE=
# GEMINI_SUMMARY_DAILY_RESERVE=
# GEMINI_CHAT_FALLBACK_MINUTE_RESERVE=
# GEMINI_CHAT_FALLBACK_DAILY_RESERVE=
# GEMINI_QUOTA_RETRY_JITTER_MS=
# CHAT_QUOTA_NORMAL_USER_DAILY_LIMIT=
# CHAT_QUOTA_HR_DAILY_LIMIT=
# CHAT_CONTEXT_CACHE_TTL_MS=
# CHAT_FAQ_CACHE_TTL_MS=
# CHAT_TOOL_ACTION_EXPIRY_MS=
